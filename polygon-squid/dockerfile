# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies (needed for some native npm packages)
RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install sqd CLI globally so `sqd` works inside the container
RUN npm install -g @subsquid/cli

# Copy installed node_modules and compiled output from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/lib         ./lib
COPY --from=builder /app/db          ./db

# Copy config files that sqd/typeorm need at runtime
COPY commands.json  ./commands.json
COPY squid.yaml     ./squid.yaml
COPY tsconfig.json  ./tsconfig.json

# entrypoint: apply migrations then start the processor
# Using process:prod intentionally — it does NOT call `sqd up` (no docker-in-docker)
CMD ["sh", "-c", "sqd migration:apply && node lib/main.js"]